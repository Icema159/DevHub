# Optional override, only needed if you are not using the Vite dev server's
# built-in /api proxy (see server.proxy in vite.config.ts, which forwards to
# the local API on http://localhost:3000). Leave this unset for normal local
# development: the app then talks to the API same-origin at /api, matching
# how production works behind the Web service's Caddy proxy.
# VITE_API_BASE_URL=http://localhost:3000
