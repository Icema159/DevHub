NODE_ENV=development
API_PORT=3000
TRUSTED_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:5173
CSRF_SECRET=replace-with-at-least-32-random-characters-in-production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://HOST:6379
APP_BASE_URL=http://localhost:5173
EMAIL_DELIVERY_DRIVER=console
RESEND_API_KEY=replace-with-a-resend-api-key
EMAIL_FROM=Developer Knowledge Hub <onboarding@resend.dev>
# SMTP is optional and used only when EMAIL_DELIVERY_DRIVER=smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=replace-with-an-smtp-username
SMTP_PASSWORD=replace-with-an-smtp-password
SMTP_FROM=Developer Knowledge Hub <no-reply@example.com>
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.local-storage
MAX_UPLOAD_SIZE_BYTES=10485760
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_CHAT_MAX_OUTPUT_TOKENS=1200
GLOBAL_OPENAI_MONTHLY_BUDGET_USD=20
R2_ACCESS_KEY_ID=replace-with-an-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-an-r2-secret-access-key
R2_BUCKET_NAME=replace-with-an-r2-bucket-name
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
